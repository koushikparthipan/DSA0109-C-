#include <iostream>
using namespace std;

int main() {
    int arr[100], n, x, pos;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter value to insert: ";
    cin >> x;

    cout << "Enter position to insert (0 to " << n << "): ";
    cin >> pos;

    // Position should be between 0 and n (inclusive)
    if (pos < 0 || pos > n) {
        cout << "Invalid position!\n";
        return 0;
    }

    // Check for overflow (array size is 100)
    if (n == 100) {
        cout << "Array is full! Cannot insert more elements.\n";
        return 0;
    }

    // Shift elements to the right from index n-1 down to pos
    for (int i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    // Insert the new element
    arr[pos] = x;
    n++;

    cout << "Array after insertion: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
