#include <iostream>
using namespace std;

class Rectangle {
private:
    double length, width;

public:
    // Constructor
    Rectangle(double l, double w) {
        length = l;
        width = w;
        cout << "Rectangle object created (Constructor called)." << endl;
    }

    // Destructor
    ~Rectangle() {
        cout << "Rectangle object destroyed (Destructor called)." << endl;
    }

    // (Optional) Function to display area
    double area() {
        return length * width;
    }
};

int main() {
    Rectangle r1(5.0, 3.0);
    cout << "Area of rectangle: " << r1.area() << endl;

    return 0;
}
