#include <iostream>
using namespace std;

int main()
{
    int num, rem;
    int freq[10] = {0};

    cout << "Enter a number: ";
    cin >> num;

    while(num > 0)
    {
        rem = num % 10;
        freq[rem]++;
        num /= 10;
    }

    cout << "Digit Frequencies:" << endl;

    for(int i = 0; i < 10; i++)
    {
        if(freq[i] != 0)
            cout << i << " = " << freq[i] << endl;
    }

    return 0;
}
