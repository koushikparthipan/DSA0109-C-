#include <iostream>
using namespace std;

class Book {
private:
    string title;
    string author;

public:
    // Constructor
    Book(string t, string a) {
        title = t;
        author = a;
        cout << "Book created: " << title << " by " << author << endl;
    }

    // Destructor
    ~Book() {
        cout << "Book destroyed: " << title << endl;
    }

    void display() {
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
    }
};

int main() {
    Book b1("The Great Gatsby", "F. Scott Fitzgerald");
    b1.display();

    return 0; // Destructor will be called automatically
}
